/assets/media/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/site-shell.js
  Cache-Control: no-store, max-age=0

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Hash-versioned WebP assets can be cached aggressively by browsers and Cloudflare.
/distributor-room/gallery/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/distributor-room/gallery/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/distributor-room/gallery/gallery-manifest.js
  Cache-Control: public, max-age=0, must-revalidate

/Gallery_2/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Original Distributor Pathways PDFs are versioned in player URLs for stable browser caching.
/distributor-room/assets/presentation/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/distributor-room/vi/assets/presentation/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800

/client-room/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' https: blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self' https://cdnjs.cloudflare.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/room-manager/*
  Cache-Control: no-store, max-age=0
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY


/client-room/starter-assets/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/client-room/starter-assets/assets/videos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
